---
const rawModules = import.meta.glob(
	[
		'../sections/*.astro',
		'../navigation/SiteNav.astro',
		'../../styles/global.css',
		'../../scripts/bootstrap.ts',
		'../../scripts/gsap.ts',
		'../../scripts/dot-grid.ts',
		'../../scripts/lenis.ts',
		'../../scripts/scroll-spy.ts',
		'../../scripts/theme.ts',
		'../../scripts/code-rain.ts',
		'../../pages/index.astro',
		'../../layouts/MainLayout.astro',
		'../../data/site-content.ts',
	],
	{ query: '?raw', import: 'default', eager: true },
) as Record<string, string>;

const MIN_LINE_LENGTH = 8;
const MAX_LINE_LENGTH = 90;

// Пул уезжает в HTML инлайном на каждый SSR-рендер, а на экране живёт
// LINE_COUNT_DESKTOP = 40 строк (code-rain.ts). Полный сбор — это ~6300 строк
// и 230 КБ, три четверти веса главной; 400 уникальных хватает, чтобы дождь
// не зациклился заметно.
const MAX_LINES = 400;

const collectLines = (): string[] => {
	const seen = new Set<string>();
	const allLines: string[] = [];

	for (const content of Object.values(rawModules)) {
		const raw = content.split('\n');
		for (const line of raw) {
			const trimmed = line.trimEnd();
			const stripped = trimmed.replace(/^\t+/, (m) => '  '.repeat(m.length));

			if (stripped.length < MIN_LINE_LENGTH) continue;
			if (/^\s*\/\//.test(stripped)) continue;
			if (/^\s*\/?\*/.test(stripped)) continue;
			if (/^\s*<!--/.test(stripped)) continue;
			if (/^\s*-{3,}$/.test(stripped)) continue;
			if (/^\s*import\s/.test(stripped) && stripped.length < 20) continue;

			const cut = stripped.length > MAX_LINE_LENGTH
				? stripped.slice(0, MAX_LINE_LENGTH) + '…'
				: stripped;

			if (seen.has(cut)) continue;
			seen.add(cut);
			allLines.push(cut);
		}
	}

	// Fisher-Yates на seeded-PRNG: сборка должна давать один и тот же пул,
	// но перемешать по-настоящему — иначе срез MAX_LINES заберёт строки
	// подряд из первых файлов glob'а.
	let seed = 0x9e3779b9;
	const rand = () => {
		seed = (seed + 0x6d2b79f5) | 0;
		let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
		t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};

	for (let i = allLines.length - 1; i > 0; i--) {
		const j = Math.floor(rand() * (i + 1));
		[allLines[i], allLines[j]] = [allLines[j], allLines[i]];
	}

	return allLines.slice(0, MAX_LINES);
};

const codeLines = collectLines();
---

<div class="background-layer" aria-hidden="true"></div>
<script is:inline define:vars={{ codeLines }}>
	window.__BG_CODE_LINES__ = codeLines;
</script>
